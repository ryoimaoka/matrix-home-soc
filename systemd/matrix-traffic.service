
[Unit]
Description=MATRIX HOME SOC Traffic Monitor
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/matrix-home-soc/venv/bin/python /opt/matrix-home-soc/app/matrix_traffic.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
